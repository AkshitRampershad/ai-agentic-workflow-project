# Groq (default, OpenAI-compatible chat completions, free tier available
# at https://console.groq.com/keys) - this is what the project is
# configured for out of the box:
GROQ_API_KEY=gsk-your-groq-key-here

# Alternative providers (uncomment ONE alternative block instead of the
# Groq key above; whichever *_API_KEY is set first, in this order, wins:
# GROQ_API_KEY, VOC_API_KEY, OPENAI_API_KEY).

# Vocareum (only reachable with an active Udacity course subscription):
# VOC_API_KEY=voc-your-key-here
# OPENAI_BASE_URL=https://openai.vocareum.com/v1
# OPENAI_MODEL=gpt-4o-mini

# OpenAI directly:
# OPENAI_API_KEY=sk-your-openai-key-here
# OPENAI_MODEL=gpt-4o-mini

# Leave every key unset to run everything in offline mode using
# deterministic mock responses (no API calls, no cost).
